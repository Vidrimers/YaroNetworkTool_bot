# TELEGRAM BOT CONFIGURATION
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_user_id

# VPN SERVER CONFIGURATION
SERVER_IP=your_server_ip
API_BASE_URL=http://your_server_ip:333

# XRAY CONFIGURATION (для генерации vless ссылок)
XRAY_PORT=8443
XRAY_PUBLIC_KEY=your_public_key_here
XRAY_SHORT_ID=your_short_id_here
XRAY_SNI=www.microsoft.com
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
XRAY_LOG_PATH=/var/log/xray/access.log

# SSH CONFIGURATION
SSH_USERNAME=root
SSH_PASSWORD=your_ssh_password
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_PORT=22

# API CONFIGURATION
API_KEY=your_api_key_here

# DATABASE
DB_PATH=./database/yaronetworkbase.db

# ENVIRONMENT
NODE_ENV=production

# PAYMENT CONFIGURATION
# ЮMoney
YUMONEY_RECEIVER=your_yumoney_wallet_number
YUMONEY_SECRET=your_yumoney_secret_key
YUMONEY_WEBHOOK_PORT=3001

# Kaspa
KASPA_ADDRESS=kaspa:your_kaspa_address_here
KASPA_API_URL=https://api.kaspa.org

# TON
TON_ADDRESS=your_ton_wallet_address
TON_API_URL=https://toncenter.com/api/v2

# USDT (TRC-20)
USDT_ADDRESS=your_tron_wallet_address
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=your_trongrid_api_key_optional
